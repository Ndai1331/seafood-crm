@using BootstrapBlazor.Server.Helper

<div class="vn-number-input">
    <input type="text"
           class="form-control @CssClass"
           value="@_display"
           placeholder="@Placeholder"
           disabled="@IsDisabled"
           @oninput="OnInputAsync"
           @onblur="OnBlurAsync" />
</div>

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public bool IsDisabled { get; set; }

    private string _display = string.Empty;
    private int? _lastSyncedValue;
    private bool _isEditing;

    protected override void OnParametersSet()
    {
        if (_isEditing)
            return;

        if (Value != _lastSyncedValue)
        {
            _lastSyncedValue = Value;
            _display = VnNumberFormatHelper.FormatInt(Value);
        }
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        _isEditing = true;
        var raw = e.Value?.ToString() ?? string.Empty;
        _display = VnNumberFormatHelper.FormatWhileTyping(raw, integerOnly: true);

        var parsed = VnNumberFormatHelper.ParseInt(_display);
        _lastSyncedValue = parsed;
        await ValueChanged.InvokeAsync(parsed);
    }

    private Task OnBlurAsync()
    {
        _isEditing = false;
        _lastSyncedValue = Value;
        _display = VnNumberFormatHelper.FormatInt(Value);
        return Task.CompletedTask;
    }
}
