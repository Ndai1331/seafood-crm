@page "/master-data/customers"
@layout PageLayout
@inject SeafoodApiService Api
@inject ToastService Toast
@inject IAppLang L

<PageChrome Title="@L["customers.title"]">
    <Actions>
        <Button Color="Color.Secondary" Icon="fa-solid fa-rotate" Text="@L["btn.refresh"]" OnClick="LoadAsync" />
        <Button Color="Color.Primary" Icon="fa-solid fa-plus" Text="@L["btn.create"]" OnClick="OpenCreate" />
    </Actions>
    <ChildContent>
        <div class="sf-panel p-0 overflow-auto">
            <Table TItem="CustomerDto" Items="_rows" IsBordered="true" IsStriped="true" IsPagination="true" AutoGenerateColumns="false">
                <TableColumns>
                    <TableColumn TItem="CustomerDto" TType="string" @bind-Field="@context.Code" Text="@L["customers.code"]" Width="100" />
                    <TableColumn TItem="CustomerDto" TType="string" @bind-Field="@context.Name" Text="@L["customers.name"]" />
                    <TableColumn TItem="CustomerDto" TType="string" @bind-Field="@context.ContactName" Text="@L["customers.contact"]" />
                    <TableColumn TItem="CustomerDto" TType="string" @bind-Field="@context.Purchaser" Text="@L["customers.purchaser"]" />
                    <TableColumn TItem="CustomerDto" TType="int" @bind-Field="@context.Id" Text="" Width="90">
                        <Template Context="v">
                            <RowActionButtons OnEdit="() => OpenEdit(v.Row)" OnDelete="() => DeleteAsync(v.Row)" />
                        </Template>
                    </TableColumn>
                </TableColumns>
            </Table>
        </div>
        <Modal @ref="_modal" Size="Size.Large">
            <ModalDialog Title="@(_form.Id == 0 ? L["btn.create"] : L["btn.edit"])" ShowSaveButton="true" OnSaveAsync="SaveAsync"
                         SaveButtonText="@L["btn.save"]" CloseButtonText="@L["btn.cancel"]">
                <BodyTemplate>
                    <div class="row g-3">
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_form.Code" DisplayText="@L["customers.code"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_form.Name" DisplayText="@L["customers.name"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_form.ContactName" DisplayText="@L["customers.contact"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_form.Purchaser" DisplayText="@L["customers.purchaser"]" ShowLabel="true" /></div>
                    </div>
                </BodyTemplate>
            </ModalDialog>
        </Modal>
    </ChildContent>
</PageChrome>

@code {
    private Modal? _modal;
    private List<CustomerDto> _rows = new();
    private CustomerDto _form = new() { IsActive = true, Kind = 1 };

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _rows = await Api.CustomersAsync() ?? new();

    private async Task OpenCreate()
    {
        _form = new() { IsActive = true, Kind = 1 };
        if (_modal != null) await _modal.Toggle();
    }

    private async Task OpenEdit(CustomerDto row)
    {
        _form = new CustomerDto
        {
            Id = row.Id, Code = row.Code, Name = row.Name, ContactName = row.ContactName,
            Purchaser = row.Purchaser, Kind = row.Kind, IsActive = row.IsActive, Note = row.Note
        };
        if (_modal != null) await _modal.Toggle();
    }

    private async Task<bool> SaveAsync()
    {
        var saved = await Api.SaveCustomerAsync(_form);
        if (saved == null) { await Toast.Error(L["msg.saveFail"]); return false; }
        await Toast.Success(L["msg.saveOk"]);
        await LoadAsync();
        return true;
    }

    private async Task DeleteAsync(CustomerDto row)
    {
        try
        {
            await Api.DeleteCustomerAsync(row.Id);
            await Toast.Success(L["msg.deleteOk"]);
            await LoadAsync();
        }
        catch
        {
            await Toast.Error(L["msg.deleteFail"]);
        }
    }
}
