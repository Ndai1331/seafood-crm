@page "/inventory/traceability"
@layout PageLayout
@inject SeafoodApiService Api
@inject ToastService Toast

<div class="sf-page">
    <div class="sf-page-header">
        <div>
            <h3>Truy xuất hai chiều</h3>
            <p>Tra theo mã lô, số HĐ, số container hoặc số hóa đơn. Đồ thị gồm phiếu nhập và hóa đơn.</p>
        </div>
        <span class="sf-status sf-status-info"><i class="fa-solid fa-route me-1" aria-hidden="true"></i>Traceability</span>
    </div>

    <div class="sf-form-section">
        <div class="row g-3 align-items-end">
            <div class="col-md-4"><BootstrapInput @bind-Value="_code" DisplayText="Mã lô / số HĐ / container / hóa đơn" ShowLabel="true" placeholder="RM-000001-0001" /></div>
            <div class="col-md-3">
                <Select @bind-Value="_ownerType" DisplayText="Hoặc loại ID" ShowLabel="true">
                    <Options>
                        <SelectOption Value="" Text="(dùng mã)" />
                        <SelectOption Value="Shipment" Text="Shipment" />
                        <SelectOption Value="SalesContract" Text="Hợp đồng" />
                        <SelectOption Value="ProductionLot" Text="Lô thành phẩm" />
                        <SelectOption Value="RawMaterialLot" Text="Lô nguyên liệu" />
                        <SelectOption Value="InboundPurchase" Text="Phiếu nhập" />
                        <SelectOption Value="SalesInvoice" Text="Hóa đơn" />
                    </Options>
                </Select>
            </div>
            <div class="col-md-2"><VnIntInput Value="@_ownerId" ValueChanged="@(value => _ownerId = value ?? 0)" DisplayText="ID" ShowLabel="true" /></div>
            <div class="col-auto"><Button Color="Color.Primary" OnClick="LoadAsync"><i class="fa-solid fa-search me-1" aria-hidden="true"></i>Tra cứu</Button></div>
        </div>
    </div>

    @if (_result == null)
    {
        <div class="sf-empty-state"><i class="fa-solid fa-diagram-project" aria-hidden="true"></i>Nhập mã nghiệp vụ hoặc loại + ID để xem chuỗi truy xuất.</div>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-md-6"><div class="sf-kpi-card"><div><div class="sf-kpi-label">Số nút</div><div class="sf-kpi-value">@_result.Nodes.Count</div></div></div></div>
            <div class="col-md-6"><div class="sf-kpi-card"><div><div class="sf-kpi-label">Số quan hệ</div><div class="sf-kpi-value">@_result.Edges.Count</div></div></div></div>
        </div>
        <div class="sf-table-shell mb-3"><Table TItem="TraceabilityNodeDto" Items="@_result.Nodes" PageItemsSource="@PageItemsSource" AutoGenerateColumns="true" IsBordered="true" IsStriped="true" IsPagination="true" /></div>
        <div class="sf-table-shell"><Table TItem="TraceabilityEdgeDto" Items="@_result.Edges" PageItemsSource="@PageItemsSource" AutoGenerateColumns="true" IsBordered="true" IsStriped="true" IsPagination="true" /></div>
    }
</div>

@code {
    private static readonly IEnumerable<int> PageItemsSource = new[] { 10, 20, 40 };
    private string _code = "";
    private string _ownerType = "";
    private int _ownerId;
    private TraceabilityDto? _result;

    private async Task LoadAsync()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(_code))
                _result = await Api.TraceabilityLookupAsync(_code.Trim());
            else if (!string.IsNullOrWhiteSpace(_ownerType) && _ownerId > 0)
                _result = await Api.TraceabilityLookupAsync(null, _ownerType, _ownerId);
            else
            {
                await Toast.Error("Nhập mã nghiệp vụ hoặc loại + ID.");
                return;
            }
            if (_result == null) await Toast.Error("Không tải được dữ liệu truy xuất.");
        }
        catch (Exception ex) { await Toast.Error("Không tra được", ApiErrorMessage.Describe(ex, "Kiểm tra mã lô / HĐ / container / hóa đơn.")); }
    }
}
