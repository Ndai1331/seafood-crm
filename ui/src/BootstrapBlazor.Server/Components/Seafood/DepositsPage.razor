@page "/finance/deposits"
@layout PageLayout
@inject SeafoodApiService Api
@inject ToastService Toast

<div class="sf-page">
    <div class="sf-page-header">
        <div>
            <h3>Deposit khách hàng</h3>
            <p>Nhận tiền đặt cọc và phân bổ vào nhiều hợp đồng hoặc hóa đơn.</p>
        </div>
        <div class="sf-page-actions">
            <span class="sf-status sf-status-warning"><i class="fa-solid fa-piggy-bank me-1" aria-hidden="true"></i>Finance</span>
            <Button Color="Color.Primary" OnClick="OpenDepositAsync"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Nhận deposit</Button>
            <Button Color="Color.Secondary" OnClick="OpenAllocationAsync"><i class="fa-solid fa-arrow-right-arrow-left me-1" aria-hidden="true"></i>Phân bổ</Button>
        </div>
    </div>

    <SeafoodCrudModal @ref="_depositModal" Title="Nhận deposit khách hàng" OnSaveAsync="SaveAsync">
        <SeafoodModalSection Title="Khoản deposit" Icon="fa-solid fa-piggy-bank">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Khách hàng</label><SeafoodSelect2 Value="@(_form.CustomerId > 0 ? (int?)_form.CustomerId : null)" ValueChanged="OnCustomerChanged" Search="SearchCustomersAsync" Placeholder="Tìm khách" /></div>
                <div class="col-md-6"><VnNumberInput Value="@_form.AmountUsd" ValueChanged="@(value => _form.AmountUsd = value ?? 0)" DisplayText="Số tiền (USD)" ShowLabel="true" /></div>
                <div class="col-12"><Textarea @bind-Value="_form.Note" DisplayText="Nội dung" ShowLabel="true" rows="2" /></div>
            </div>
        </SeafoodModalSection>
    </SeafoodCrudModal>

    <SeafoodCrudModal @ref="_allocationModal" Title="Phân bổ deposit" OnSaveAsync="AllocateAsync" Size="Size.Large">
        <SeafoodModalSection Title="Nguồn tiền" Icon="fa-solid fa-wallet">
            <div class="row g-3">
                <div class="col-md-6"><VnIntInput Value="@_depositId" ValueChanged="@(value => _depositId = value ?? 0)" DisplayText="Deposit Id" ShowLabel="true" /></div>
                <div class="col-md-6"><VnNumberInput Value="@_alloc" ValueChanged="@(value => _alloc = value ?? 0)" DisplayText="Số phân bổ (USD)" ShowLabel="true" /></div>
            </div>
        </SeafoodModalSection>
        <SeafoodModalSection Title="Đích phân bổ" Icon="fa-solid fa-arrow-right-arrow-left">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Hợp đồng</label><SeafoodSelect2 Value="@(_contractId > 0 ? (int?)_contractId : null)" ValueChanged="OnContractChanged" Search="SearchContractsAsync" Placeholder="Tìm HĐ" /></div>
                <div class="col-md-6"><label class="form-label">Hóa đơn</label><SeafoodSelect2 Value="@_invoiceId" ValueChanged="OnInvoiceChanged" Search="SearchInvoicesAsync" Placeholder="Tìm hóa đơn" /></div>
            </div>
        </SeafoodModalSection>
    </SeafoodCrudModal>

    <SeafoodFilterBar Search="@_search" SearchChanged="OnSearchChangedAsync" ResultCount="@_total" Placeholder="Tìm khách hàng, ghi chú..." />
    <div class="sf-table-shell">
        <Table TItem="CustomerDepositDto" PageItemsSource="@PageItemsSource" AutoGenerateColumns="false" IsBordered="true" IsStriped="true" IsPagination="true" ShowToolbar="false" ShowSearch="false" ShowLoading="true" OnQueryAsync="@OnQueryAsync" @ref="_table">
            <TableColumns>
                <TableColumn TItem="CustomerDepositDto" TType="string" @bind-Field="@context.CustomerName" Text="Khách" Width="200" />
                <TableColumn TItem="CustomerDepositDto" TType="decimal" @bind-Field="@context.AmountUsd" Text="Nhận" Width="120" Align="Alignment.Right" />
                <TableColumn TItem="CustomerDepositDto" TType="decimal" @bind-Field="@context.AllocatedUsd" Text="Đã phân bổ" Width="130" Align="Alignment.Right" />
                <TableColumn TItem="CustomerDepositDto" TType="int" @bind-Field="@context.Id" Text="Chi tiết" Width="280"><Template Context="value">@(value.Row.Allocations.Count == 0 ? "Chưa phân bổ" : string.Join("; ", value.Row.Allocations.Select(a => $"{a.ContractNo ?? a.InvoiceNo}: {a.AmountUsd:N0}"))) </Template></TableColumn>
                <TableColumn TItem="CustomerDepositDto" TType="int" @bind-Field="@context.CustomerId" Text="" Width="120" Align="Alignment.Right">
                    <Template Context="value"><Button Color="Color.Secondary" IsOutline="true" Size="Size.ExtraSmall" Text="Phân bổ" OnClick="() => OpenAllocationForAsync(value.Row)" /></Template>
                </TableColumn>
            </TableColumns>
        </Table>
    </div>
</div>

@code {
    private static readonly IEnumerable<int> PageItemsSource = new[] { 10, 20, 40, 80 };
    private Table<CustomerDepositDto>? _table;
    private CustomerDepositDto _form = new();
    private SeafoodCrudModal? _depositModal, _allocationModal;
    private int _depositId, _contractId;
    private int? _invoiceId;
    private decimal _alloc;
    private string _search = "";
    private int _total;

    private async Task<QueryData<CustomerDepositDto>> OnQueryAsync(QueryPageOptions options)
    {
        var page = await Api.DepositsPageAsync(_search, Math.Max(0, options.PageIndex - 1) * options.PageItems, options.PageItems);
        _total = page?.TotalCount ?? 0;
        await InvokeAsync(StateHasChanged);
        return SeafoodTableQuery.ToQueryData(page, options);
    }
    private async Task OnSearchChangedAsync(string value) { _search = value; if (_table != null) await _table.QueryAsync(1); }
    private async Task OpenDepositAsync() { _form = new(); if (_depositModal != null) await _depositModal.ShowAsync(); }
    private async Task OpenAllocationAsync() { _depositId = 0; _contractId = 0; _invoiceId = null; _alloc = 0; if (_allocationModal != null) await _allocationModal.ShowAsync(); }
    private async Task OpenAllocationForAsync(CustomerDepositDto row) { _depositId = row.Id; _alloc = Math.Max(0, row.AmountUsd - row.AllocatedUsd); if (_allocationModal != null) await _allocationModal.ShowAsync(); }
    private async Task<bool> SaveAsync()
    {
        var saved = await Api.SaveDepositAsync(_form);
        if (saved == null) { await Toast.Error("Không lưu deposit"); return false; }
        await Toast.Success("Đã nhận deposit");
        if (_table != null) await _table.QueryAsync(1);
        return true;
    }
    private Task OnCustomerChanged(int? value) { _form.CustomerId = value ?? 0; return Task.CompletedTask; }
    private Task OnContractChanged(int? value) { _contractId = value ?? 0; return Task.CompletedTask; }
    private Task OnInvoiceChanged(int? value) { _invoiceId = value; return Task.CompletedTask; }
    private async Task<SeafoodSelect2SearchResponseDto> SearchCustomersAsync(string term, int page, int pageSize) => await Api.SearchCustomersAsync(term, page, pageSize) ?? new();
    private async Task<SeafoodSelect2SearchResponseDto> SearchContractsAsync(string term, int page, int pageSize) => await Api.SearchContractOptionsAsync(term, page, pageSize) ?? new();
    private async Task<SeafoodSelect2SearchResponseDto> SearchInvoicesAsync(string term, int page, int pageSize) => await Api.SearchInvoiceOptionsAsync(term, page, pageSize) ?? new();
    private async Task<bool> AllocateAsync()
    {
        try
        {
            var saved = await Api.AllocateDepositAsync(_depositId, _contractId > 0 ? _contractId : null, _alloc, _invoiceId);
            if (saved == null) { await Toast.Error("Không phân bổ được deposit"); return false; }
            await Toast.Success("Đã phân bổ deposit");
            if (_table != null) await _table.QueryAsync(1);
            return true;
        }
        catch (Exception ex) { await Toast.Error("Không phân bổ được", ApiErrorMessage.Describe(ex, "Chọn hợp đồng hoặc hóa đơn.")); return false; }
    }
}
