@page "/finance/deposits"
@layout PageLayout
@inject SeafoodApiService Api
@inject ToastService Toast
@inject IAppLang L

<PageChrome Title="@L["deposits.title"]">
    <Actions>
        <Button Color="Color.Secondary" Icon="fa-solid fa-rotate" Text="@L["btn.refresh"]" OnClick="LoadAsync" />
        <Button Color="Color.Primary" Icon="fa-solid fa-plus" Text="@L["btn.create"]" OnClick="OpenCreate" />
    </Actions>
    <ChildContent>
        <div class="sf-panel p-0 overflow-auto">
            <Table TItem="CustomerDepositDto" Items="_rows" IsBordered="true" IsStriped="true" AutoGenerateColumns="false">
                <TableColumns>
                    <TableColumn TItem="CustomerDepositDto" TType="string" @bind-Field="@context.CustomerName" Text="@L["customers.name"]" />
                    <TableColumn TItem="CustomerDepositDto" TType="decimal" @bind-Field="@context.AmountUsd" Text="@L["deposits.amount"]" FormatString="N2" />
                    <TableColumn TItem="CustomerDepositDto" TType="decimal" @bind-Field="@context.RemainingUsd" Text="@L["deposits.remaining"]" FormatString="N2" />
                    <TableColumn TItem="CustomerDepositDto" TType="int" @bind-Field="@context.Id" Text="" Width="180">
                        <Template Context="v">
                            <div class="d-flex gap-1">
                                <RowActionButtons OnEdit="() => OpenEdit(v.Row)" OnDelete="() => DeleteAsync(v.Row)" />
                                <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-share" Text="@L["btn.allocate"]" OnClick="() => OpenAlloc(v.Row)" />
                            </div>
                        </Template>
                    </TableColumn>
                </TableColumns>
            </Table>
        </div>
        <Modal @ref="_modal" Size="Size.Large">
            <ModalDialog Title="@L["deposits.title"]" ShowSaveButton="true" OnSaveAsync="SaveAsync"
                         SaveButtonText="@L["btn.save"]" CloseButtonText="@L["btn.cancel"]">
                <BodyTemplate>
                    <div class="row g-3">
                        <div class="col-12"><Select TValue="int" Items="_customers" @bind-Value="_form.CustomerId" DisplayText="@L["customers.title"]" ShowLabel="true" /></div>
                        <div class="col-12"><label class="form-label">@L["deposits.amount"]</label><UsdMoneyInput Value="_form.AmountUsd" ValueChanged="v => _form.AmountUsd = v ?? 0" /></div>
                        <div class="col-12"><BootstrapInput @bind-Value="_form.Note" DisplayText="@L["deposits.note"]" ShowLabel="true" /></div>
                    </div>
                </BodyTemplate>
            </ModalDialog>
        </Modal>
        <Modal @ref="_allocModal" Size="Size.Large">
            <ModalDialog Title="@L["btn.allocate"]" ShowSaveButton="true" OnSaveAsync="AllocateAsync"
                         SaveButtonText="@L["btn.save"]" CloseButtonText="@L["btn.cancel"]">
                <BodyTemplate>
                    <div class="row g-3">
                        <div class="col-12"><Select TValue="int" Items="_contracts" @bind-Value="_contractId" DisplayText="@L["quotes.contractNo"]" ShowLabel="true" /></div>
                        <div class="col-12"><label class="form-label">USD</label><UsdMoneyInput Value="_alloc" ValueChanged="v => _alloc = v ?? 0" /></div>
                    </div>
                </BodyTemplate>
            </ModalDialog>
        </Modal>
    </ChildContent>
</PageChrome>

@code {
    private Modal? _modal;
    private Modal? _allocModal;
    private List<CustomerDepositDto> _rows = new();
    private CustomerDepositDto _form = new();
    private List<SelectedItem> _customers = new();
    private List<SelectedItem> _contracts = new();
    private int _depositId;
    private int _contractId;
    private decimal _alloc;

    protected override async Task OnInitializedAsync()
    {
        _customers = (await Api.CustomersAsync() ?? new()).Select(c => new SelectedItem(c.Id.ToString(), c.Name)).ToList();
        _contracts = (await Api.QuotesAsync() ?? new()).Select(c => new SelectedItem(c.Id.ToString(), c.ContractNo)).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync() => _rows = await Api.DepositsAsync() ?? new();

    private async Task OpenCreate()
    {
        _form = new CustomerDepositDto();
        if (_modal != null) await _modal.Toggle();
    }

    private async Task OpenEdit(CustomerDepositDto row)
    {
        _form = row;
        if (_modal != null) await _modal.Toggle();
    }

    private async Task OpenAlloc(CustomerDepositDto row)
    {
        _depositId = row.Id;
        _alloc = row.RemainingUsd;
        if (_allocModal != null) await _allocModal.Toggle();
    }

    private async Task<bool> SaveAsync()
    {
        var saved = await Api.SaveDepositAsync(_form);
        if (saved == null) { await Toast.Error(L["msg.saveFail"]); return false; }
        await Toast.Success(L["msg.saveOk"]);
        await LoadAsync();
        return true;
    }

    private async Task<bool> AllocateAsync()
    {
        await Api.AllocateDepositAsync(_depositId, _contractId, _alloc);
        await Toast.Success(L["msg.saveOk"]);
        await LoadAsync();
        return true;
    }

    private async Task DeleteAsync(CustomerDepositDto row)
    {
        try { await Api.DeleteDepositAsync(row.Id); await Toast.Success(L["msg.deleteOk"]); await LoadAsync(); }
        catch { await Toast.Error(L["msg.deleteFail"]); }
    }
}
