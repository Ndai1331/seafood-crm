@page "/master-data/products"
@layout PageLayout
@inject SeafoodApiService Api
@inject ToastService Toast
@inject IAppLang L

<PageChrome Title="@L["products.title"]">
    <Actions>
        <Button Color="Color.Secondary" Icon="fa-solid fa-rotate" Text="@L["btn.refresh"]" OnClick="LoadAsync" />
        <Button Color="Color.Primary" Icon="fa-solid fa-plus" Text="@L["btn.create"]" OnClick="OpenCreate" />
    </Actions>
    <ChildContent>
        @foreach (var group in _groups)
        {
            <h5 class="mt-2 mb-2">@group.Name <small class="text-muted">(@group.DefaultMarket)</small></h5>
            <div class="sf-panel p-0 overflow-auto">
                <Table TItem="ProductSkuDto" Items="group.Skus" IsBordered="true" IsStriped="true" AutoGenerateColumns="false">
                    <TableColumns>
                        <TableColumn TItem="ProductSkuDto" TType="string" @bind-Field="@context.Code" Text="@L["catalog.code"]" Width="140" />
                        <TableColumn TItem="ProductSkuDto" TType="string" @bind-Field="@context.Name" Text="@L["catalog.name"]" />
                        <TableColumn TItem="ProductSkuDto" TType="string" @bind-Field="@context.ExportMarket" Text="@L["products.market"]" Width="120" />
                        <TableColumn TItem="ProductSkuDto" TType="decimal" @bind-Field="@context.DefaultUnitPriceUsd" Text="@L["products.priceUsd"]" Width="120" FormatString="N2" />
                        <TableColumn TItem="ProductSkuDto" TType="int" @bind-Field="@context.Id" Text="" Width="90">
                            <Template Context="v">
                                <RowActionButtons OnEdit="() => OpenEdit(v.Row)" OnDelete="() => DeleteAsync(v.Row)" />
                            </Template>
                        </TableColumn>
                    </TableColumns>
                </Table>
            </div>
        }
        <Modal @ref="_modal" Size="Size.Large">
            <ModalDialog Title="@(_sku.Id == 0 ? L["btn.create"] : L["btn.edit"])" ShowSaveButton="true" OnSaveAsync="SaveAsync"
                         SaveButtonText="@L["btn.save"]" CloseButtonText="@L["btn.cancel"]">
                <BodyTemplate>
                    <div class="row g-3">
                        <div class="col-12"><Select TValue="int" Items="_groupItems" @bind-Value="_sku.GroupId" DisplayText="@L["products.group"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_sku.Code" DisplayText="@L["catalog.code"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_sku.Name" DisplayText="@L["products.sku"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_sku.ExportMarket" DisplayText="@L["products.market"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@L["products.priceUsd"]</label>
                            <UsdMoneyInput Value="_sku.DefaultUnitPriceUsd" ValueChanged="v => _sku.DefaultUnitPriceUsd = v ?? 0" />
                        </div>
                    </div>
                </BodyTemplate>
            </ModalDialog>
        </Modal>
    </ChildContent>
</PageChrome>

@code {
    private Modal? _modal;
    private List<ProductGroupDto> _groups = new();
    private ProductSkuDto _sku = new() { IsActive = true };
    private List<SelectedItem> _groupItems = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _groups = await Api.ProductsAsync() ?? new();
        _groupItems = _groups.Select(g => new SelectedItem(g.Id.ToString(), g.Name)).ToList();
    }

    private async Task OpenCreate()
    {
        _sku = new() { IsActive = true, GroupId = _groups.FirstOrDefault()?.Id ?? 0 };
        if (_modal != null) await _modal.Toggle();
    }

    private async Task OpenEdit(ProductSkuDto row)
    {
        _sku = new ProductSkuDto
        {
            Id = row.Id, GroupId = row.GroupId, Code = row.Code, Name = row.Name,
            ExportMarket = row.ExportMarket, DefaultUnitPriceUsd = row.DefaultUnitPriceUsd,
            IsByproduct = row.IsByproduct, IsActive = row.IsActive
        };
        if (_modal != null) await _modal.Toggle();
    }

    private async Task<bool> SaveAsync()
    {
        var saved = await Api.SaveSkuAsync(_sku);
        if (saved == null) { await Toast.Error(L["msg.saveFail"]); return false; }
        await Toast.Success(L["msg.saveOk"]);
        await LoadAsync();
        return true;
    }

    private async Task DeleteAsync(ProductSkuDto row)
    {
        try { await Api.DeleteSkuAsync(row.Id); await Toast.Success(L["msg.deleteOk"]); await LoadAsync(); }
        catch { await Toast.Error(L["msg.deleteFail"]); }
    }
}
