@page "/inventory"
@layout PageLayout
@inject SeafoodApiService Api
@inject ToastService Toast
@inject NavigationManager Navigation

<div class="sf-page">
    <div class="sf-page-header">
        <div>
            <h3>Tồn kho &amp; chứng từ</h3>
            <p>So khớp tồn SKU với hợp đồng mở và chứng từ đủ điều kiện xuất khẩu.</p>
        </div>
        <span class="sf-status sf-status-warning"><i class="fa-solid fa-warehouse me-1" aria-hidden="true"></i>Ledger + kiểm soát</span>
    </div>

    <SeafoodFilterBar Search="@_search" SearchChanged="OnSearchChangedAsync" ResultCount="@_total" Placeholder="Tìm lot, SKU, chứng từ hoặc cảnh báo..." />
    <div class="mb-3"><Button Color="Color.Primary" IsOutline="true" Icon="fa-solid fa-route" Text="Mở truy xuất hai chiều" OnClick="OpenTraceabilityAsync" /></div>
    <div class="sf-form-section mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-3"><VnIntInput Value="@_adjustment.InventoryBalanceId" ValueChanged="@(value => _adjustment.InventoryBalanceId = value ?? 0)" DisplayText="ID dòng tồn" ShowLabel="true" /></div>
            <div class="col-md-3"><VnNumberInput Value="@_adjustment.QuantityKg" ValueChanged="@(value => _adjustment.QuantityKg = value ?? 0)" DisplayText="Điều chỉnh kg (+/-)" ShowLabel="true" /></div>
            <div class="col-md-4"><Textarea @bind-Value="_adjustment.Reason" DisplayText="Lý do" ShowLabel="true" placeholder="Biên bản kiểm kê..." rows="2" /></div>
            <div class="col-auto"><Button Color="Color.Warning" OnClick="AdjustAsync"><i class="fa-solid fa-scale-balanced me-1" aria-hidden="true"></i>Ghi điều chỉnh</Button></div>
        </div>
    </div>
    <div class="sf-table-shell">
        <Table TItem="InventoryRowDto" PageItemsSource="@PageItemsSource" AutoGenerateColumns="true" IsBordered="true" IsStriped="true" IsPagination="true" ShowToolbar="false" ShowSearch="false" ShowLoading="true" OnQueryAsync="@OnQueryAsync" @ref="_table" />
    </div>
</div>

@code {
    private static readonly IEnumerable<int> PageItemsSource = new[] { 10, 20, 40, 80 };
    private Table<InventoryRowDto>? _table;
    private string _search = "";
    private int _total;
    private InventoryAdjustmentDto _adjustment = new();

    private async Task<QueryData<InventoryRowDto>> OnQueryAsync(QueryPageOptions options)
    {
        var page = await Api.InventoryPageAsync(_search, Math.Max(0, options.PageIndex - 1) * options.PageItems, options.PageItems);
        _total = page?.TotalCount ?? 0;
        await InvokeAsync(StateHasChanged);
        return SeafoodTableQuery.ToQueryData(page, options);
    }
    private async Task OnSearchChangedAsync(string value) { _search = value; if (_table != null) await _table.QueryAsync(1); }

    private async Task AdjustAsync()
    {
        var saved = await Api.AdjustInventoryAsync(_adjustment);
        if (saved == null) { await Toast.Error("Không ghi được điều chỉnh tồn kho."); return; }
        await Toast.Success("Đã ghi điều chỉnh vào inventory ledger.");
        _adjustment = new();
        if (_table != null) await _table.QueryAsync(1);
    }

    private Task OpenTraceabilityAsync()
    {
        Navigation.NavigateTo("/inventory/traceability");
        return Task.CompletedTask;
    }
}
