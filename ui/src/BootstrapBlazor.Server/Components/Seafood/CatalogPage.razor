@page "/master-data/catalog"
@layout PageLayout
@inject SeafoodApiService Api
@inject ToastService Toast
@inject IAppLang L

<PageChrome Title="@L["catalog.title"]">
    <Actions>
        <Button Color="Color.Secondary" Icon="fa-solid fa-rotate" Text="@L["btn.refresh"]" OnClick="LoadAsync" />
        <Button Color="Color.Primary" Icon="fa-solid fa-plus" Text="@L["btn.create"]" OnClick="OpenCreate" />
    </Actions>
    <ChildContent>
        <div class="sf-panel mb-3">
            <Select TValue="int?" Items="_cats" @bind-Value="_filter" OnSelectedItemChanged="_ => LoadAsync()" DisplayText="@L["catalog.category"]" ShowLabel="true" />
        </div>
        <div class="sf-panel p-0 overflow-auto">
            <Table TItem="CatalogLookupDto" Items="_rows" IsBordered="true" IsStriped="true" IsPagination="true" AutoGenerateColumns="false">
                <TableColumns>
                    <TableColumn TItem="CatalogLookupDto" TType="string" @bind-Field="@context.Code" Text="@L["catalog.code"]" Width="120" />
                    <TableColumn TItem="CatalogLookupDto" TType="string" @bind-Field="@context.Name" Text="@L["catalog.name"]" />
                    <TableColumn TItem="CatalogLookupDto" TType="string" @bind-Field="@context.Description" Text="@L["catalog.description"]" />
                    <TableColumn TItem="CatalogLookupDto" TType="int" @bind-Field="@context.Id" Text="" Width="90">
                        <Template Context="v">
                            <RowActionButtons OnEdit="() => OpenEdit(v.Row)" OnDelete="() => DeleteAsync(v.Row)" />
                        </Template>
                    </TableColumn>
                </TableColumns>
            </Table>
        </div>
        <Modal @ref="_modal" Size="Size.Large">
            <ModalDialog Title="@(_form.Id == 0 ? L["btn.create"] : L["btn.edit"])" ShowSaveButton="true" OnSaveAsync="SaveAsync"
                         SaveButtonText="@L["btn.save"]" CloseButtonText="@L["btn.cancel"]">
                <BodyTemplate>
                    <div class="row g-3">
                        <div class="col-12"><Select TValue="int" Items="_catRequired" @bind-Value="_form.Category" DisplayText="@L["catalog.category"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_form.Code" DisplayText="@L["catalog.code"]" ShowLabel="true" /></div>
                        <div class="col-12 col-md-6"><BootstrapInput @bind-Value="_form.Name" DisplayText="@L["catalog.name"]" ShowLabel="true" /></div>
                        <div class="col-12"><BootstrapInput @bind-Value="_form.Description" DisplayText="@L["catalog.description"]" ShowLabel="true" /></div>
                    </div>
                </BodyTemplate>
            </ModalDialog>
        </Modal>
    </ChildContent>
</PageChrome>

@code {
    private Modal? _modal;
    private List<CatalogLookupDto> _rows = new();
    private CatalogLookupDto _form = new() { IsActive = true };
    private int? _filter;
    private List<SelectedItem> _cats = new();
    private List<SelectedItem> _catRequired = new();

    protected override async Task OnInitializedAsync()
    {
        _cats = new List<SelectedItem> { new("", L["btn.search"]) };
        foreach (var (id, name) in Categories())
        {
            _cats.Add(new(id.ToString(), name));
            _catRequired.Add(new(id.ToString(), name));
        }
        await LoadAsync();
    }

    private static (int id, string name)[] Categories() => new[]
    {
        (1, "Fish species"), (2, "Fish form"), (3, "Size"), (4, "Sensory"), (5, "Catch"),
        (6, "Freeze"), (7, "Certificate"), (8, "Origin"), (9, "Market"),
        (10, "Warehouse"), (11, "Carrier"), (12, "Container")
    };

    private async Task LoadAsync() => _rows = await Api.CatalogAsync(_filter) ?? new();

    private async Task OpenCreate()
    {
        _form = new() { IsActive = true, Category = _filter ?? 1 };
        if (_modal != null) await _modal.Toggle();
    }

    private async Task OpenEdit(CatalogLookupDto row)
    {
        _form = new CatalogLookupDto
        {
            Id = row.Id, Category = row.Category, Code = row.Code, Name = row.Name,
            Description = row.Description, SortOrder = row.SortOrder, IsActive = row.IsActive
        };
        if (_modal != null) await _modal.Toggle();
    }

    private async Task<bool> SaveAsync()
    {
        var saved = await Api.SaveCatalogAsync(_form);
        if (saved == null) { await Toast.Error(L["msg.saveFail"]); return false; }
        await Toast.Success(L["msg.saveOk"]);
        await LoadAsync();
        return true;
    }

    private async Task DeleteAsync(CatalogLookupDto row)
    {
        try { await Api.DeleteCatalogAsync(row.Id); await Toast.Success(L["msg.deleteOk"]); await LoadAsync(); }
        catch { await Toast.Error(L["msg.deleteFail"]); }
    }
}
