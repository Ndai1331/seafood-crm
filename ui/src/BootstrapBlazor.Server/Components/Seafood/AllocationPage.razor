@page "/export/allocations"
@layout PageLayout
@inject SeafoodApiService Api
@inject ToastService Toast
@inject IJSRuntime JS

<div class="sf-page">
    <div class="sf-page-header">
        <div>
            <h3>Xếp lô &amp; chứng từ</h3>
            <p>Ghép nhiều lô FIFO, cảnh báo đủ hàng thiếu giấy, trừ lùi nguyên liệu theo định mức thu hồi.</p>
        </div>
        <span class="sf-status sf-status-info"><i class="fa-solid fa-layer-group me-1" aria-hidden="true"></i>FIFO + trừ lùi</span>
    </div>

    <div class="sf-form-section">
        <div class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6"><label class="form-label">Hợp đồng</label><SeafoodSelect2 Value="@(_request.SalesContractId > 0 ? (int?)_request.SalesContractId : null)" ValueChanged="OnContractChanged" Search="SearchContractsAsync" Placeholder="Tìm số HĐ hoặc khách" /></div>
            <div class="col-lg-3 col-md-6"><DateTimePicker @bind-Value="_etd" DisplayText="ETD" ShowLabel="true" /></div>
            <div class="col-auto"><Button Color="Color.Primary" OnClick="PreviewAsync"><i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"></i>Preview phương án</Button></div>
            @if (_preview != null)
            {
                <div class="col-auto"><Button Color="Color.Success" OnClick="ConfirmAsync"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Xác nhận giữ hàng</Button></div>
                <div class="col-auto"><Button Color="Color.Warning" OnClick="ReleaseAsync"><i class="fa-solid fa-unlock me-1" aria-hidden="true"></i>Giải phóng</Button></div>
            }
        </div>
        @if (_preview != null)
        {
            <div class="row g-3 mt-2">
                <div class="col-md-8"><Switch @bind-Value="_overrideDocs" DisplayText="Override thiếu giấy" ShowLabel="true" OnText="Có" OffText="Không" /></div>
                <div class="col-md-4"><BootstrapInput @bind-Value="_overrideReason" DisplayText="Lý do override" ShowLabel="true" /></div>
            </div>
        }
    </div>

    @if (_preview != null)
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4"><div class="sf-kpi-card"><div><div class="sf-kpi-label">Nhu cầu</div><div class="sf-kpi-value">@_preview.RequiredKg.ToString("N0") <small>kg</small></div></div></div></div>
            <div class="col-md-4"><div class="sf-kpi-card"><div><div class="sf-kpi-label">Có thể xếp (đủ giấy)</div><div class="sf-kpi-value">@_preview.AllocatableKg.ToString("N0") <small>kg</small></div></div></div></div>
            <div class="col-md-4"><div class="sf-kpi-card"><div><div class="sf-kpi-label">Còn thiếu</div><div class="sf-kpi-value">@_preview.MissingKg.ToString("N0") <small>kg</small></div></div></div></div>
        </div>
        <div class="sf-table-shell">
            <Table TItem="AllocationCandidateDto" Items="@_preview.Candidates" PageItemsSource="@PageItemsSource" AutoGenerateColumns="false" IsBordered="true" IsStriped="true" IsPagination="true">
                <TableColumns>
                    <TableColumn TItem="AllocationCandidateDto" TType="bool" @bind-Field="@context.Selected" Text="Chọn" Width="80"><Template Context="value"><Switch Value="@value.Row.Selected" ValueChanged="v => value.Row.Selected = v" /></Template></TableColumn>
                    <TableColumn TItem="AllocationCandidateDto" TType="string" @bind-Field="@context.LotNumber" Text="Lô" Width="140" />
                    <TableColumn TItem="AllocationCandidateDto" TType="string" @bind-Field="@context.SkuName" Text="SKU" Width="180" />
                    <TableColumn TItem="AllocationCandidateDto" TType="decimal" @bind-Field="@context.AvailableKg" Text="Khả dụng" Width="110" Align="Alignment.Right" />
                    <TableColumn TItem="AllocationCandidateDto" TType="decimal" @bind-Field="@context.SuggestedKg" Text="Xếp (kg)" Width="110" Align="Alignment.Right"><Template Context="value"><VnNumberInput Value="@value.Row.SuggestedKg" ValueChanged="v => value.Row.SuggestedKg = v ?? 0" ShowLabel="false" /></Template></TableColumn>
                    <TableColumn TItem="AllocationCandidateDto" TType="decimal" @bind-Field="@context.RawEquivalentKg" Text="Trừ lùi NL" Width="120" Align="Alignment.Right" />
                    <TableColumn TItem="AllocationCandidateDto" TType="decimal" @bind-Field="@context.RemainingFgKg" Text="TP còn đi" Width="110" Align="Alignment.Right" />
                    <TableColumn TItem="AllocationCandidateDto" TType="decimal" @bind-Field="@context.RemainingRawKg" Text="NL còn đi" Width="110" Align="Alignment.Right" />
                    <TableColumn TItem="AllocationCandidateDto" TType="bool" @bind-Field="@context.IsDocumentReady" Text="Giấy" Width="160">
                        <Template Context="value">
                            @if (value.Value) { <span class="sf-status sf-status-info">Đủ giấy</span> }
                            else { <span class="sf-status sf-status-warning">Thiếu: @string.Join(", ", value.Row.MissingDocuments)</span> }
                        </Template>
                    </TableColumn>
                </TableColumns>
            </Table>
        </div>
        @if (_preview.Candidates.Any(x => x.MissingDocuments.Count > 0))
        {
            <div class="alert alert-warning mt-3 mb-0"><i class="fa-solid fa-file-circle-exclamation me-2" aria-hidden="true"></i>Lô đủ hàng nhưng thiếu giấy vẫn hiện để đối chiếu. Chỉ giữ các dòng đã tick; override cần quyền và lý do.</div>
        }
    }
    else
    {
        <div class="sf-empty-state"><i class="fa-solid fa-arrows-to-circle" aria-hidden="true"></i>Chọn hợp đồng để xem phương án xếp lô FIFO và số kg còn đi được theo bộ giấy.</div>
    }
</div>

@code {
    private static readonly IEnumerable<int> PageItemsSource = new[] { 10, 20, 40 };
    private AllocationPreviewRequestDto _request = new();
    private AllocationPreviewDto? _preview;
    private DateTime _etd = DateTime.Today;
    private bool _overrideDocs;
    private string _overrideReason = "";

    private Task OnContractChanged(int? value) { _request.SalesContractId = value ?? 0; _preview = null; return Task.CompletedTask; }
    private async Task<SeafoodSelect2SearchResponseDto> SearchContractsAsync(string term, int page, int pageSize) => await Api.SearchContractOptionsAsync(term, page, pageSize) ?? new();
    private async Task PreviewAsync()
    {
        _request.Etd = _etd;
        try
        {
            _preview = await Api.PreviewAllocationAsync(_request);
            if (_preview == null) await Toast.Error("Không tải được phương án xếp lô.");
        }
        catch (Exception ex) { await Toast.Error("Không preview được", ApiErrorMessage.Describe(ex, "Chọn hợp đồng đã duyệt.")); }
    }
    private async Task ConfirmAsync()
    {
        if (_preview == null) return;
        var items = _preview.Candidates.Where(x => x.Selected && x.SuggestedKg > 0).ToList();
        if (items.Any(x => !x.IsDocumentReady) && (!_overrideDocs || string.IsNullOrWhiteSpace(_overrideReason)))
        {
            await Toast.Warning("Các lô thiếu giấy cần bật override và nhập lý do.");
            return;
        }
        try
        {
            var result = await Api.ConfirmAllocationAsync(new AllocationConfirmDto
            {
                SalesContractId = _preview.SalesContractId,
                Etd = _request.Etd,
                OverrideDocumentCheck = _overrideDocs,
                OverrideReason = _overrideReason,
                Items = items.Select(x => new AllocationItemDto { SalesContractLineId = x.ContractLineId, InventoryBalanceId = x.InventoryBalanceId, QuantityKg = x.SuggestedKg }).ToList()
            });
            if (result == null) { await Toast.Error("Không thể xác nhận giữ hàng."); return; }
            await Toast.Success($"Đã giữ {result.AllocatedKg:N0} kg. Trừ lùi NL theo định mức thu hồi của từng mẻ.");
            await PreviewAsync();
        }
        catch (Exception ex) { await Toast.Error("Không giữ được hàng", ApiErrorMessage.Describe(ex, "Bỏ tick lô thiếu giấy hoặc điền override.")); }
    }
    private async Task ReleaseAsync()
    {
        if (_request.SalesContractId <= 0 || !await JS.InvokeAsync<bool>("confirm", "Giải phóng toàn bộ hàng đang giữ cho hợp đồng này?")) return;
        if (await Api.ReleaseAllocationAsync(new AllocationReleaseDto { SalesContractId = _request.SalesContractId, Reason = "Người dùng giải phóng reservation" }))
        {
            await Toast.Success("Đã giải phóng reservation.");
            await PreviewAsync();
        }
        else await Toast.Error("Không thể giải phóng reservation.");
    }
}
