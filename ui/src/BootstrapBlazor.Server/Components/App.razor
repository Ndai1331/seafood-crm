@inject IWebHostEnvironment Env
@inject IStringLocalizer<BaseLayout> Localizer
@inject IOptions<WebsiteOptions> WebsiteOption

<!DOCTYPE html>
<html lang="en" data-bs-theme='light'>

<head>
    <meta charset="utf-8" />
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="Seafood CRM">
    <meta name="description" content="Seafood processing CRM">
    <meta name="author" content="NKaisel">
    <meta name="theme-color" content="#6814d0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>Seafood CRM</title>
    <base href="/" />
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="favicon.png">

    <link rel="stylesheet" href="@Assets["_content/BootstrapBlazor.FontAwesome/css/font-awesome.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BootstrapBlazor.MaterialDesign/css/md.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BootstrapBlazor.BootstrapIcon/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BootstrapBlazor/css/bootstrap.blazor.bundle.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BootstrapBlazor/css/motronic.min.css"]" />
    <link rel="stylesheet" href="@Assets["BootstrapBlazor.Server.styles.css"]" />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <link rel="stylesheet" href="@Assets["css/seo-global.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/sidebar-menu.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/seo-tables.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/seo-tabs.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/seo-charts.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/page-routes.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/seafood-saas.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/ncc-catalog.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/wiki.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/seafood-tokens.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["css/seafood-top-menu.css"]" asp-append-version="true" />
    <link rel="stylesheet" href="@Assets["lib/select2/css/select2.min.css"]" asp-append-version="true" />
    <ImportMap></ImportMap>

    <HeadOutlet @rendermode="new InteractiveServerRenderMode(false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(false)" />

    <ReconnectorOutlet ReconnectInterval="5000" @rendermode="new InteractiveServerRenderMode(false)" />
@* 
    <UpdateIntro @rendermode="new InteractiveServerRenderMode(false)" /> *@

    <BlazorReconnector @rendermode="new InteractiveServerRenderMode(false)" />

    <script src="_content/BootstrapBlazor.SummerNote/js/jquery-3.6.0.min.js"></script>
    <script src="lib/select2/js/select2.min.js" asp-append-version="true"></script>
    <script src="_content/BootstrapBlazor/js/bootstrap.blazor.bundle.min.js"></script>
    <script src="js/seafood-select2.js" asp-append-version="true"></script>
    <script src="js/tabsAlignment.js" asp-append-version="true"></script>
    <script src="js/floating-label-positioner.js" asp-append-version="true"></script>
    <script src="js/table-rowspan-styler.js" asp-append-version="true"></script>
    <script src="js/sticky-cell-color.js" asp-append-version="true"></script>
    <script src="js/jsuites.js"></script>
    <script src="js/jspreadsheet.js"></script>
    <script src="js/echarts.min.js"></script>
    <script src="js/seo-dashboard-charts.js" asp-append-version="true"></script>
    <script src="js/wiki-graph.js" asp-append-version="true"></script>
    <script src="js/spidercave-graph.js" asp-append-version="true"></script>
    <script src="js/wallet-risk-graph.js" asp-append-version="true"></script>
    <script src="js/wiki-trend-chart.js" asp-append-version="true"></script>
    <script src="js/clipboard-copy.js" asp-append-version="true"></script>
    <script src="_framework/blazor.web.js"></script>
    @* Removed: the BootstrapBlazor demo site's ad network (cdn.wwads.cn) and Baidu Analytics.
       They were inherited with the template and ran in Production only, so they never showed up
       in local development — on every page of an internal tool, including the login screen where
       people type their password, reporting browsing activity to third parties. Nothing here
       needs them. *@
</body>

</html>
