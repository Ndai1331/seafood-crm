@page "/menu-arrangement"
@namespace BootstrapBlazor.Server.Components.Task9
@layout PageLayout
@inherits BootstrapComponentBase

@using BootstrapBlazor.Components
@using BootstrapBlazor.Server.Services
@using BootstrapBlazor.Server.Services.I18n

@inject IAppLang L
<PageTitle>@L["nav.menu"]</PageTitle>

<PageChrome Title="@L["nav.menu"]" Subtitle="Kéo-thả hoặc dùng nút ▲▼◀▶ để đổi thứ tự module/page. Lưu để áp dụng.">
    <Actions>
        <Button Color="Color.Secondary" Icon="fa-solid fa-rotate" Text="@L["btn.refresh"]" OnClick="ReloadAsync" IsDisabled="@IsBusy" />
        <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" Text="@L["btn.save"]" OnClick="SaveAsync" IsDisabled="@(!IsDirty || IsBusy)" />
    </Actions>
    <ChildContent>
    <div class="container-fluid px-0">

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Trang mặc định khi đăng nhập theo vai trò</strong>
            <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" OnClick="SaveRoleDefaultsAsync" IsDisabled="@IsBusy">Lưu</Button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Vai trò</th><th>Trang mặc định</th></tr></thead>
                    <tbody>
                        @foreach (var role in RoleDefaults)
                        {
                            <tr>
                                <td>@role.RoleName</td>
                                <td>
                                    <Select TValue="string" @bind-Value="role.DefaultPageUrl">
                                        <Options>
                                            <SelectOption Text="Theo mặc định hệ thống" Value="" />
                                            @foreach (var page in DefaultPageOptions)
                                            {
                                                <SelectOption Text="@(page.Text)" Value="@(page.Url)" />
                                            }
                                        </Options>
                                    </Select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="menu-arrangement-add-module mb-3">
        <input class="form-control form-control-sm" style="max-width:220px" placeholder="Tên module mới"
               @bind="NewModuleName" @bind:event="oninput" />
        <input class="form-control form-control-sm" style="max-width:220px" placeholder="Icon (vd: fa-solid fa-folder)"
               @bind="NewModuleIcon" @bind:event="oninput" />
        <i class="@NewModuleIcon menu-arrangement-icon-preview" title="Xem trước icon"></i>
        <Button Color="Color.Secondary" Icon="fa-solid fa-plus" OnClick="AddModule">Thêm module</Button>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else
    {
        <div class="menu-arrangement-columns">
            @for (var moduleIndex = 0; moduleIndex < Modules.Count; moduleIndex++)
            {
                var module = Modules[moduleIndex];
                var mIndex = moduleIndex;
                <div class="menu-arrangement-column"
                     draggable="true"
                     @ondragstart="() => OnModuleDragStart(module.Text)"
                     @ondragover:preventDefault
                     @ondrop="() => OnDropOnModule(module)">
                    <div class="menu-arrangement-column-header">
                        <i class="@module.Icon"></i>
                        <span class="fw-bold">@module.Text</span>
                        <div class="ms-auto d-flex gap-1">
                            <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-angle-up"
                                    title="Đưa module lên" IsDisabled="@(mIndex == 0)" OnClick="() => MoveModule(mIndex, -1)" />
                            <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-angle-down"
                                    title="Đưa module xuống" IsDisabled="@(mIndex == Modules.Count - 1)" OnClick="() => MoveModule(mIndex, 1)" />
                            @if (module.Items.Count == 0 && IsCustomModule(module))
                            {
                                <Button Color="Color.Danger" Size="Size.ExtraSmall" Icon="fa-solid fa-trash"
                                        title="Xóa module rỗng" OnClick="() => RemoveEmptyModule(module)" />
                            }
                        </div>
                    </div>
                    <div class="menu-arrangement-column-body">
                        @for (var pageIndex = 0; pageIndex < module.Items.Count; pageIndex++)
                        {
                            var pg = module.Items[pageIndex];
                            var pIndex = pageIndex;
                            <div class="menu-arrangement-card @(pg.Enabled ? "" : "menu-arrangement-card-disabled")" draggable="@(!pg.IsHiddenByDefault && RenamingUrl != pg.Url)"
                                 @ondragstart="() => OnPageDragStart(module.Text, pg.Url)">
                                @if (RenamingUrl == pg.Url)
                                {
                                    <i class="@pg.Icon menu-arrangement-card-icon"></i>
                                    <input class="form-control form-control-sm menu-arrangement-rename-input"
                                           placeholder="Tên hiển thị trên menu" maxlength="256"
                                           @ref="RenameInput"
                                           @bind="RenameDraft" @bind:event="oninput"
                                           @onkeydown="e => OnRenameKeyDown(e, pg)" />
                                    <div class="d-flex gap-1">
                                        <Button Color="Color.Success" Size="Size.ExtraSmall" Icon="fa-solid fa-check"
                                                title="Lưu tên mới" OnClick="() => CommitRename(pg)" />
                                        <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-rotate-left"
                                                title="@($"Về tên gốc trong code: {pg.DefaultText}")"
                                                IsDisabled="@(pg.Text == pg.DefaultText)" OnClick="() => ResetRename(pg)" />
                                        <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-xmark"
                                                title="Huỷ" OnClick="CancelRename" />
                                    </div>
                                }
                                else
                                {
                                <i class="@pg.Icon menu-arrangement-card-icon"></i>
                                <span class="menu-arrangement-card-text" title="@(pg.Text == pg.DefaultText ? pg.Text : $"{pg.Text} (tên gốc: {pg.DefaultText})")">@pg.Text</span>
                                @if (pg.Text != pg.DefaultText)
                                {
                                    <span class="badge text-bg-info" title="Đã đổi tên — tên gốc trong code: @pg.DefaultText">Đã đổi tên</span>
                                }
                                @if (!pg.Enabled)
                                {
                                    <span class="badge text-bg-warning" title="Không hiện trên sidebar — bấm khôi phục để hiện lại">Đã ẩn</span>
                                }
                                @if (pg.IsHiddenByDefault)
                                {
                                    <span class="badge text-bg-secondary ms-auto" title="Trang ẩn mặc định — không đổi module/thứ tự được, chỉ xoá khỏi menu / khôi phục">Ẩn mặc định</span>
                                }
                                else
                                {
                                    <div class="d-flex gap-1 ms-auto">
                                        <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-angle-left"
                                                title="Chuyển sang module trước" IsDisabled="@(mIndex == 0)"
                                                OnClick="() => MovePageToModule(module, pg, -1)" />
                                        <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-angle-up"
                                                title="Đưa lên" IsDisabled="@(pIndex == 0)"
                                                OnClick="() => MovePage(module, pIndex, -1)" />
                                        <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-angle-down"
                                                title="Đưa xuống" IsDisabled="@(pIndex == module.Items.Count - 1)"
                                                OnClick="() => MovePage(module, pIndex, 1)" />
                                        <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-angle-right"
                                                title="Chuyển sang module sau" IsDisabled="@(mIndex == Modules.Count - 1)"
                                                OnClick="() => MovePageToModule(module, pg, 1)" />
                                    </div>
                                }
                                <div class="d-flex gap-1">
                                    <Button Color="Color.Secondary" Size="Size.ExtraSmall" Icon="fa-solid fa-pen"
                                            title="Đổi tên hiển thị trên menu" OnClick="() => StartRename(pg)" />
                                    @if (pg.Enabled)
                                    {
                                        <Button Color="Color.Danger" Size="Size.ExtraSmall" Icon="fa-solid fa-trash"
                                                title="Xoá khỏi menu" OnClick="() => ToggleEnabled(pg)" />
                                    }
                                    else
                                    {
                                        <Button Color="Color.Success" Size="Size.ExtraSmall" Icon="fa-solid fa-rotate-left"
                                                title="Khôi phục lên menu" OnClick="() => ToggleEnabled(pg)" />
                                    }
                                </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    </div>
    </ChildContent>
</PageChrome>
