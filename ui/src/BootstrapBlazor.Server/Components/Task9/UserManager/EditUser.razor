@page "/user-manager/edit/{UserId:int}"
@using BootstrapBlazor.Components
@using BootstrapBlazor.Server.Data
@using BootstrapBlazor.Server.Services
@layout PageLayout

<h1>Chỉnh sửa người dùng</h1>
<div id="page-user-manager-edit">
<DemoBlock Title="" Name="EditUser">
    @if (IsLoadingData)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <p class="mt-2">Đang tải thông tin người dùng...</p>
        </div>
    }
    else if (Model != null)
    {
        <ValidateForm Model="@Model" OnValidSubmit="@OnValidSubmit">
            <div class="row g-3 mt-1">
                <div class="col-12 col-sm-6">
                    <BootstrapInput @bind-Value="@Model.UserName" 
                        DisplayText="Tên đăng nhập" 
                        ShowLabel="true"
                        placeholder="Nhập tên đăng nhập" Class="seo-input-size" Size="Size.Large" />
                </div>
                
                <div class="col-12 col-sm-6">
                    <BootstrapInput @bind-Value="@Model.UserCode" 
                        DisplayText="Mã nhân viên" 
                        ShowLabel="true"
                        placeholder="Nhập mã nhân viên" Class="seo-input-size" Size="Size.Large" />
                </div>
                
                <div class="col-12 col-sm-6">
                    <BootstrapInput @bind-Value="@Model.FirstName" 
                        DisplayText="Họ" 
                        ShowLabel="true"
                        placeholder="Nhập họ" Class="seo-input-size" Size="Size.Large" />
                </div>
                
                <div class="col-12 col-sm-6">
                    <BootstrapInput @bind-Value="@Model.LastName" 
                        DisplayText="Tên" 
                        ShowLabel="true"
                        placeholder="Nhập tên" Class="seo-input-size" Size="Size.Large" />
                </div>
                
                <div class="col-12 col-sm-6">
                    <BootstrapInput @bind-Value="@Model.Email" 
                        DisplayText="Email" 
                        ShowLabel="true"
                        placeholder="Nhập email" Class="seo-input-size" Size="Size.Large" />
                </div>
                
                <div class="col-12 col-sm-6">
                    <BootstrapInput @bind-Value="@Model.PhoneNumber" 
                        DisplayText="Số điện thoại" 
                        ShowLabel="true"
                        placeholder="Nhập số điện thoại" Class="seo-input-size" Size="Size.Large" />
                </div>
                
                <div class="col-12 col-sm-6">
                    <Select @bind-Value="@Model.Gender"
                        DisplayText="Giới tính"
                        ShowLabel="true" Class="seo-input-size" Size="Size.Large">
                        <Options>
                            <SelectOption Value="1" Text="Nam" />
                            <SelectOption Value="0" Text="Nữ" />
                            <SelectOption Value="2" Text="Không xác định" />
                        </Options>
                    </Select>
                </div>

                <div class="col-12 col-sm-6">
                    <Select @bind-Value="@Model.UserType"
                        DisplayText="Loại nhân viên"
                        ShowLabel="true" Class="seo-input-size" Size="Size.Large">
                        <Options>
                            <SelectOption Value="0" Text="Inhouse" />
                            <SelectOption Value="1" Text="Remote" />
                            <SelectOption Value="2" Text="OS Z" />
                            <SelectOption Value="3" Text="OS NA" />
                        </Options>
                    </Select>
                </div>

                <div class="col-12 col-sm-6">
                    <DateTimePicker @bind-Value="@Model.DOB"
                        DisplayText="Ngày sinh"
                        ShowLabel="true"
                        DateFormat="dd/MM/yyyy" Class="seo-input-size" Size="Size.Large" />
                </div>
                
             
                
                <div class="col-12 col-sm-6">
                    <MultiSelect @bind-Value="@SelectedRoles" 
                        DisplayText="Vai trò (*)" 
                        ShowLabel="true"
                        Items="@RoleItems"
                        placeholder="Chọn vai trò" Class="seo-input-size" Size="Size.Large" />
                </div>
                
                <div class="col-12 col-sm-6">
                    <Select @bind-Value="@SelectedPositionId" 
                        DisplayText="Chức vụ" 
                        ShowLabel="true"
                        Items="@PositionItems"
                        placeholder="Chọn chức vụ" Class="seo-input-size" Size="Size.Large"     />
                </div>
                
                <div class="col-12 col-sm-6">
                    <Select @bind-Value="@SelectedTeamId" 
                        DisplayText="Team" 
                        ShowLabel="true"
                        Items="@TeamItems"
                        placeholder="Chọn team" Class="seo-input-size" Size="Size.Large" />
                </div>
                
            </div>
            <div class="row g-3">
                <div class="col-12 col-sm-2">
                    <div class="toggle-container">
                        <Switch @bind-Value="@Model.IsActive" 
                            DisplayText="" 
                            ShowLabel="false"
                            OnColor="Color.Success"
                            OffColor="Color.Secondary" />
                        <label class="toggle-label">
                            Trạng thái<br/><span class="toggle-label-small">hoạt động</span>
                        </label>
                    </div>
                </div>
                
                <div class="col-12 col-sm-2">
                    <div class="toggle-container">
                        <Switch @bind-Value="@Model.IsSetPassword" 
                            DisplayText=""
                            ShowLabel="false"
                            OnColor="Color.Success"
                            OffColor="Color.Secondary" />
                        <label class="toggle-label">
                            Đổi mật<br/><span class="toggle-label-small">khẩu</span>
                        </label>
                    </div>
                </div>
                
                <div class="col-12 col-sm-8">
                    <BootstrapInput @bind-Value="@Model.Address" 
                        DisplayText="Địa chỉ" 
                        ShowLabel="true"
                        placeholder="Nhập địa chỉ" Class="seo-input-size" Size="Size.Large" />
                </div>
            </div>
            <div class="row">
                @if (Model.IsSetPassword)
                {
                    <div class="col-12 col-sm-6">
                        <BootstrapInput @bind-Value="@Model.Password" 
                            DisplayText="Mật khẩu mới" 
                            ShowLabel="true"
                            Type="text"
                            placeholder="Nhập mật khẩu mới" Class="seo-input-size" Size="Size.Large" />
                    </div>
                    
                    <div class="col-12 col-sm-6">
                        <BootstrapInput @bind-Value="@Model.PasswordConfirm" 
                            DisplayText="Xác nhận mật khẩu" 
                            ShowLabel="true"
                            Type="text"
                            placeholder="Nhập lại mật khẩu" Class="seo-input-size" Size="Size.Large" />
                    </div>
                }
                
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="totp-admin-card">
                        <div class="totp-admin-header">
                            <div>
                                <h5>Google Authenticator</h5>
                                <div class="text-muted">Quản lý xác thực 2 bước và recovery codes của user này</div>
                            </div>
                            <span class="totp-admin-status @(AdminTotpEnabled ? "enabled" : "disabled")">
                                @(AdminTotpFeatureEnabled ? (AdminTotpEnabled ? "Đang bật" : "Đang tắt") : "Tắt ở hệ thống")
                            </span>
                        </div>
                        @if (!AdminTotpFeatureLoaded)
                        {
                            <div class="text-muted mt-2">Đang tải trạng thái Authenticator...</div>
                        }
                        else if (!AdminTotpFeatureEnabled)
                        {
                            <div class="text-muted mt-2">Google Authenticator đang tắt ở cấu hình hệ thống.</div>
                        }
                        else
                        {
                            <div class="mt-2">Recovery codes còn lại: <b>@AdminRemainingRecoveryCodes</b></div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <Button ButtonType="ButtonType.Button"
                                    Color="Color.Warning"
                                    Icon="fa-solid fa-rotate"
                                    OnClick="@OnAdminRegenerateRecoveryCodes"
                                    IsDisabled="@(!AdminTotpEnabled || IsAdminTotpBusy)">
                                    Tạo lại recovery codes
                                </Button>
                                <Button ButtonType="ButtonType.Button"
                                    Color="Color.Danger"
                                    Icon="fa-solid fa-ban"
                                    OnClick="@OnAdminDisableTotp"
                                    IsDisabled="@(!AdminTotpEnabled || IsAdminTotpBusy)">
                                    Tắt 2FA user
                                </Button>
                            </div>
                        }

                        @if (AdminRecoveryCodes.Any())
                        {
                            <div class="totp-admin-recovery mt-3">
                                <div class="fw-semibold mb-2">Recovery codes mới, chỉ hiển thị một lần</div>
                                <div class="totp-admin-code-grid">
                                    @foreach (var recoveryCodeItem in AdminRecoveryCodes)
                                    {
                                        <code>@recoveryCodeItem</code>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (AdminSecurityKeyFeatureEnabled)
            {
                <div class="col-12">
                    <div class="totp-admin-card">
                        <div class="totp-admin-header">
                            <div class="fw-semibold">Khoá bảo mật</div>
                            <span class="totp-admin-status @(AdminSecurityKeyCount > 0 ? "enabled" : "disabled")">
                                @(AdminSecurityKeyCount > 0 ? $"{AdminSecurityKeyCount} khoá" : "Chưa có khoá")
                            </span>
                        </div>
                        <div class="totp-admin-body">
                            @if (AdminSecurityKeyCount == 0)
                            {
                                <div class="text-muted mb-2">
                                    User này chưa đăng ký khoá nào. Họ tự đăng ký ở trang Hồ sơ.
                                </div>
                            }
                            else
                            {
                                <div class="text-muted mb-2">
                                    Dùng gần nhất:
                                    @(AdminSecurityKeyLastUsed.HasValue
                                        ? AdminSecurityKeyLastUsed.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        : "chưa dùng lần nào")
                                </div>
                                <Button ButtonType="ButtonType.Button"
                                    Color="Color.Danger"
                                    Icon="fa-solid fa-key"
                                    OnClick="@OnAdminResetSecurityKeys"
                                    IsDisabled="@IsAdminSecurityKeyBusy">
                                    Gỡ toàn bộ khoá của user này
                                </Button>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="row">
                <div class="col-12">
                    <div class="d-flex gap-2 align-items-center">
                        <Button ButtonType="ButtonType.Submit" Class="seo-input-size" Size="Size.Large"
                            Color="Color.Primary" 
                            Icon="fa-solid fa-save"
                            IsDisabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Cập nhật
                        </Button>
                        <Button Class="seo-input-size" Size="Size.Large"
                            Color="Color.Warning" 
                            Icon="fa-solid fa-clone"
                            OnClick="@OnCloneUser"
                            IsDisabled="@IsLoading">
                            @if (IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Nhân bản
                        </Button>

                        <Button Color="Color.Secondary" Class="seo-input-size" Size="Size.Large"
                            Icon="fa-solid fa-times"
                            OnClick="@OnCancel"
                            IsDisabled="@IsLoading">
                            Hủy
                        </Button>
                    </div>
                </div>
            </div>
        </ValidateForm>
    }
    else
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-exclamation-triangle"></i>
            Không tìm thấy thông tin người dùng.
        </div>
    }
</DemoBlock>
</div>
