@page "/permission-matrix"
@namespace BootstrapBlazor.Server.Components.Task9
@layout PageLayout
@inherits BootstrapComponentBase

@using BootstrapBlazor.Components
@using BootstrapBlazor.Server.Services

<PageTitle>Phân quyền</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1"><i class="fa-solid fa-user-shield me-2"></i>Phân quyền theo Page & Module</h4>
            <span class="text-muted">Tick = role được truy cập page. Lưu để áp dụng (hiệu lực ngay, không cần deploy).</span>
        </div>
        <div>
            <Button Color="Color.Secondary" Icon="fa-solid fa-rotate" OnClick="ReloadAsync" IsDisabled="@IsBusy">Tải lại</Button>
            <Button Color="Color.Primary" Icon="fa-solid fa-floppy-disk" OnClick="SaveAsync" IsDisabled="@(!HasChanges || IsBusy)">
                Lưu (@ChangeCount thay đổi)
            </Button>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else
    {
        <div class="table-responsive" style="max-height: calc(100vh - 220px); overflow:auto;">
            <table class="table table-bordered table-sm align-middle" style="min-width: 900px;">
                <thead class="sticky-top bg-body">
                    <tr>
                        <th style="min-width: 280px;">Module / Page</th>
                        @foreach (var role in Roles)
                        {
                            <th class="text-center" style="min-width: 90px;">@role.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var moduleGroup in CatalogByModule)
                    {
                        <tr class="table-secondary">
                            <td class="fw-bold">@moduleGroup.Key</td>
                            @foreach (var role in Roles)
                            {
                                var allChecked = moduleGroup.All(item => IsChecked(role.Id, item.Code));
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input"
                                           checked="@allChecked"
                                           @onchange="e => ToggleModule(role.Id, moduleGroup.Key, (bool)e.Value!)" />
                                </td>
                            }
                        </tr>
                        @foreach (var item in moduleGroup)
                        {
                            <tr>
                                <td class="ps-4">
                                    @item.Text
                                    <span class="text-muted small ms-1">/@item.Url</span>
                                </td>
                                @foreach (var role in Roles)
                                {
                                    <td class="text-center @(IsDirty(role.Id, item.Code) ? "table-warning" : "")">
                                        <input type="checkbox" class="form-check-input"
                                               checked="@IsChecked(role.Id, item.Code)"
                                               @onchange="e => Toggle(role.Id, item.Code, (bool)e.Value!)" />
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>
