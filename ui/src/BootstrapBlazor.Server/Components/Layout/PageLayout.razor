<script type="module">
    // Import và init route menu handler module
    // Module sẽ tự expose handleRouteChange và expandActiveMenu ra window
    (async () => {
        try {
            const module = await import('/js/RouteMenuHandler.js');
            
            // Init module khi DOM ready
            const initModule = () => {
                if (module.init) {
                    setTimeout(() => {
                        module.init('sidebar');
                    }, 500);
                }
            };
            
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initModule);
            } else {
                initModule();
            }
        } catch (error) {
            console.error('Error loading RouteMenuHandler module:', error);
        }
    })();
</script>

<script>
    // Download file from base64 data (used by Excel export)
    window.downloadFile = function(filename, base64) {
        var link = document.createElement('a');
        link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,' + base64;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    // Download a CSV file from base64 (content already includes a UTF-8 BOM for Excel diacritics).
    window.downloadCsvBase64 = function(filename, base64) {
        var link = document.createElement('a');
        link.href = 'data:text/csv;charset=utf-8;base64,' + base64;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    };

    // Copy text to clipboard with fallback for non-secure contexts / permission denied.
    // Returns true on success, false on failure. Never throws.
    window.copyTextWithFallback = async function(text) {
        try {
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(text);
                return true;
            }
        } catch (e) { /* fall through to legacy method */ }

        try {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.top = '-9999px';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            var ok = document.execCommand('copy');
            document.body.removeChild(ta);
            return ok;
        } catch (e) {
            return false;
        }
    };

    function disableNavLinkCollapse(navLink) {
        if (!navLink) return;
        if (!navLink.dataset.originalBsToggle) {
            const currentToggle = navLink.getAttribute('data-bs-toggle');
            navLink.dataset.originalBsToggle = currentToggle ? currentToggle : 'collapse';
        }
        navLink.setAttribute('data-bs-toggle-disabled', 'true');
        navLink.removeAttribute('data-bs-toggle');
    }

    function enableNavLinkCollapse(navLink) {
        if (!navLink) return;
        const originalToggle = navLink.dataset.originalBsToggle || 'collapse';
        navLink.setAttribute('data-bs-toggle', originalToggle);
        navLink.removeAttribute('data-bs-toggle-disabled');
    }

    // Ngăn chặn toggle liên tục cho collapse menu
    function setupCollapseTogglePrevention() {
        const sidebar = document.getElementById('sidebar');
        const sidebarMobile = document.getElementById('sidebar-mobile');
        
        const setupForContainer = (container) => {
            if (!container) return;
            
            const navLinks = container.querySelectorAll('.nav-link[data-bs-toggle="collapse"]');
            navLinks.forEach(navLink => {
                // Remove existing handler nếu có
                if (navLink._collapseToggleHandler) {
                    navLink.removeEventListener('click', navLink._collapseToggleHandler, true);
                    delete navLink._collapseToggleHandler;
                }
                
                // Thêm handler mới
                const handler = function(e) {
                    const targetId = navLink.getAttribute('data-bs-target');
                    if (!targetId) return;
                    
                    const collapse = container.querySelector(targetId);
                    if (!collapse) return;
                    
                    // Kiểm tra xem collapse đang trong quá trình animation không
                    if (collapse.classList.contains('collapsing')) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        return false;
                    }
                    
                    // Kiểm tra xem có đang toggle không (tránh double click)
                    if (navLink.dataset.toggling === 'true') {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        return false;
                    }
                    
                    // Ngăn chặn navigation của Blazor NavLink (vì href="javascript:void(0)")
                    // Nhưng vẫn cho phép Bootstrap collapse hoạt động
                    if (navLink.getAttribute('href') === 'javascript:void(0);') {
                        e.preventDefault();
                    }
                    
                    // Đánh dấu đang toggle
                    navLink.dataset.toggling = 'true';
                    
                    // Track trạng thái hiện tại trước khi toggle
                    const wasExpanded = collapse.classList.contains('show');
                    const collapseId = collapse.id;
                    
                    // Reset flag sau khi animation xong
                    const resetToggle = () => {
                        navLink.dataset.toggling = 'false';
                        
                        // Nếu menu được đóng (từ expanded -> collapsed), track vào manually closed
                        const isNowExpanded = collapse.classList.contains('show');
                        if (wasExpanded && !isNowExpanded && collapseId) {
                            // User đã manually đóng menu
                            if (typeof trackManualMenuClose === 'function') {
                                trackManualMenuClose(collapseId);
                            }
                        } else if (!wasExpanded && isNowExpanded && collapseId) {
                            // User đã manually mở menu, xóa khỏi manually closed
                            if (typeof clearManualMenuClose === 'function') {
                                clearManualMenuClose(collapseId);
                            }
                        }
                    };
                    
                    // Lắng nghe sự kiện khi collapse animation kết thúc
                    const handleTransitionEnd = () => {
                        collapse.removeEventListener('transitionend', handleTransitionEnd);
                        collapse.removeEventListener('bsTransitionEnd', handleTransitionEnd);
                        resetToggle();
                    };
                    
                    collapse.addEventListener('transitionend', handleTransitionEnd, { once: true });
                    collapse.addEventListener('bsTransitionEnd', handleTransitionEnd, { once: true });
                    
                    // Fallback: reset sau 500ms
                    setTimeout(resetToggle, 500);
                };
                
                navLink.addEventListener('click', handler, true);
                navLink._collapseToggleHandler = handler;
            });
        };
        
        setupForContainer(sidebar);
        setupForContainer(sidebarMobile);
    }
    
    // Setup khi DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(setupCollapseTogglePrevention, 100);
        });
    } else {
        setTimeout(setupCollapseTogglePrevention, 100);
    }
    
    // Setup lại sau khi Blazor render
    setTimeout(setupCollapseTogglePrevention, 500);
    setTimeout(setupCollapseTogglePrevention, 1000);

    // Toggle mobile sidebar function
    function toggleMobileSidebar() {
        const offcanvasElement = document.getElementById('sidebar-offcanvas');
        if (!offcanvasElement) {
            console.error('Offcanvas element not found');
            return;
        }
        
        // Try multiple ways to access Bootstrap
        let Bootstrap = null;
        if (typeof bootstrap !== 'undefined') {
            Bootstrap = bootstrap;
        } else if (typeof window.bootstrap !== 'undefined') {
            Bootstrap = window.bootstrap;
        } else if (typeof window.Bootstrap !== 'undefined') {
            Bootstrap = window.Bootstrap;
        }
        
        if (Bootstrap && Bootstrap.Offcanvas) {
            try {
                const offcanvas = Bootstrap.Offcanvas.getOrCreateInstance(offcanvasElement);
                offcanvas.toggle();
                return;
            } catch (error) {
                console.error('Error toggling offcanvas:', error);
            }
        }
        
        // Fallback: manually toggle classes
        const isShowing = offcanvasElement.classList.contains('show');
        if (isShowing) {
            offcanvasElement.classList.remove('show');
            const backdrop = document.querySelector('.offcanvas-backdrop');
            if (backdrop) {
                backdrop.remove();
            }
            document.body.style.overflow = '';
        } else {
            offcanvasElement.classList.add('show');
            offcanvasElement.style.visibility = 'visible';
            // Create backdrop
            const backdrop = document.createElement('div');
            backdrop.className = 'offcanvas-backdrop fade show';
            backdrop.style.position = 'fixed';
            backdrop.style.top = '0';
            backdrop.style.left = '0';
            backdrop.style.width = '100vw';
            backdrop.style.height = '100vh';
            backdrop.style.backgroundColor = 'rgba(0, 0, 0, 0.5)';
            backdrop.style.zIndex = '1040';
            backdrop.onclick = function() {
                toggleMobileSidebar();
            };
            document.body.appendChild(backdrop);
            document.body.style.overflow = 'hidden';
        }
    }
    
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('main-content');
        const toggleIcon = document.querySelector('#sidebar-toggle-desktop i');

        if (sidebar && mainContent) {
            // Toggle CSS classes
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('sidebar-collapsed');

            // Lưu trạng thái vào localStorage
            const isCollapsed = sidebar.classList.contains('collapsed');
            localStorage.setItem('sidebarCollapsed', isCollapsed ? 'true' : 'false');
            
            // Xử lý theo trạng thái mới
            if (isCollapsed) {
                // Khi sidebar collapsed: Đóng tất cả collapse
                const navLinks = sidebar.querySelectorAll('.nav-link[data-bs-toggle="collapse"], .nav-link[data-bs-toggle-disabled="true"]');
                navLinks.forEach(navLink => {
                    disableNavLinkCollapse(navLink);
                    const targetId = navLink.getAttribute('data-bs-target');
                    if (targetId) {
                        const collapse = sidebar.querySelector(targetId);
                        if (collapse) {
                            collapse.classList.remove('show');
                        }
                    }
                });
            } else {
                // Khi sidebar expanded: Remove hover classes và enable collapse
                const navItems = sidebar.querySelectorAll('.nav-item');
                navItems.forEach(item => {
                    item.classList.remove('submenu-hover');
                });
                const navLinks = sidebar.querySelectorAll('.nav-link[data-bs-toggle-disabled="true"], .nav-link[data-bs-toggle="collapse"]');
                navLinks.forEach(navLink => {
                    enableNavLinkCollapse(navLink);
                });
                
                // Expand active menu khi sidebar expanded
                setTimeout(() => {
                    window.expandActiveMenu?.();
                }, 100);
            }

            // Toggle icons - Đảm bảo icon luôn hiển thị
            if (toggleIcon) {
                // Đảm bảo icon không bị ẩn
                toggleIcon.style.display = 'flex';
                toggleIcon.style.visibility = 'visible';
                toggleIcon.style.opacity = '1';
                
                if (sidebar.classList.contains('collapsed')) {
                    toggleIcon.classList.remove('fa-chevron-left');
                    toggleIcon.classList.add('fa-chevron-right');
                } else {
                    toggleIcon.classList.remove('fa-chevron-right');
                    toggleIcon.classList.add('fa-chevron-left');
                }
            } else {
                // Nếu icon bị mất, tạo lại
                const toggleButton = document.querySelector('#sidebar-toggle-desktop');
                if (toggleButton && !toggleButton.querySelector('i')) {
                    const icon = document.createElement('i');
                    icon.className = sidebar.classList.contains('collapsed') ? 'fas fa-chevron-right' : 'fas fa-chevron-left';
                    icon.style.display = 'flex';
                    icon.style.alignItems = 'center';
                    icon.style.justifyContent = 'center';
                    icon.style.width = '100%';
                    icon.style.height = '100%';
                    toggleButton.appendChild(icon);
                }
            }
        }
    }
    
    // Khôi phục trạng thái sidebar từ localStorage khi trang load
    function restoreSidebarState(retryCount = 0) {
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.getElementById('main-content');
        const toggleIcon = document.querySelector('#sidebar-toggle-desktop i');
        
        // Check if menu items are rendered (max 20 retries = 2 seconds)
        const menuItems = sidebar?.querySelectorAll('.nav-item');
        if ((!menuItems || menuItems.length === 0) && retryCount < 20) {
            // Retry after a short delay if menu not rendered yet
            setTimeout(() => restoreSidebarState(retryCount + 1), 100);
            return;
        }
        
        if (sidebar && mainContent) {
            // Đọc trạng thái từ localStorage
            const savedState = localStorage.getItem('sidebarCollapsed');
            const shouldBeCollapsed = savedState === 'true';
            
            // Kiểm tra trạng thái hiện tại
            const isCurrentlyCollapsed = sidebar.classList.contains('collapsed');
            
            // Nếu trạng thái lưu khác với trạng thái hiện tại, toggle lại
            if (shouldBeCollapsed !== isCurrentlyCollapsed) {
                sidebar.classList.toggle('collapsed');
                mainContent.classList.toggle('sidebar-collapsed');
                
                // Cập nhật icon - Đảm bảo icon luôn hiển thị
                if (toggleIcon) {
                    // Đảm bảo icon không bị ẩn
                    toggleIcon.style.display = 'flex';
                    toggleIcon.style.visibility = 'visible';
                    toggleIcon.style.opacity = '1';
                    
                    if (shouldBeCollapsed) {
                        toggleIcon.classList.remove('fa-chevron-left');
                        toggleIcon.classList.add('fa-chevron-right');
                    } else {
                        toggleIcon.classList.remove('fa-chevron-right');
                        toggleIcon.classList.add('fa-chevron-left');
                    }
                } else {
                    // Nếu icon bị mất, tạo lại
                    const toggleButton = document.querySelector('#sidebar-toggle-desktop');
                    if (toggleButton && !toggleButton.querySelector('i')) {
                        const icon = document.createElement('i');
                        icon.className = shouldBeCollapsed ? 'fas fa-chevron-right' : 'fas fa-chevron-left';
                        icon.style.display = 'flex';
                        icon.style.alignItems = 'center';
                        icon.style.justifyContent = 'center';
                        icon.style.width = '100%';
                        icon.style.height = '100%';
                        toggleButton.appendChild(icon);
                    }
                }
            }
            
            // Xử lý theo trạng thái
            if (shouldBeCollapsed) {
                // Nếu sidebar collapsed: Đóng tất cả collapse
                const navLinks = sidebar.querySelectorAll('.nav-link[data-bs-toggle="collapse"], .nav-link[data-bs-toggle-disabled="true"]');
                navLinks.forEach(navLink => {
                    disableNavLinkCollapse(navLink);
                    const targetId = navLink.getAttribute('data-bs-target');
                    if (targetId) {
                        const collapse = sidebar.querySelector(targetId);
                        if (collapse) {
                            collapse.classList.remove('show');
                        }
                    }
                });
            } else {
                // Nếu sidebar expanded: Reset hover styles
                const navItems = sidebar.querySelectorAll('.nav-item');
                navItems.forEach(item => {
                    item.classList.remove('submenu-hover');
                });
                const navLinks = sidebar.querySelectorAll('.nav-link[data-bs-toggle-disabled="true"], .nav-link[data-bs-toggle="collapse"]');
                navLinks.forEach(navLink => {
                    enableNavLinkCollapse(navLink);
                });
                
                // Expand active menu khi sidebar expanded (chỉ mở nếu có active child)
                setTimeout(() => {
                    window.expandActiveMenu?.();
                }, 200);
            }
            
            // Apply active parent menu styles sau khi restore
            setTimeout(() => {
                if (typeof applyActiveParentMenuStyles === 'function') {
                    applyActiveParentMenuStyles();
                }
            }, 100);
        }
    }
    
    // Thử khôi phục ngay khi DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', restoreSidebarState);
        } else {
        restoreSidebarState();
    }
    
    // Đợi Blazor render xong (sử dụng setTimeout để đảm bảo DOM đã được render)
    setTimeout(restoreSidebarState, 100);
    setTimeout(restoreSidebarState, 500);
    
    // Lắng nghe khi Blazor đã load xong
    window.addEventListener('load', restoreSidebarState);
    
    // Xử lý hover để hiển thị submenu khi sidebar collapsed
    function setupCollapsedSubmenuHover(retryCount = 0) {
        const sidebar = document.getElementById('sidebar');
        if (!sidebar) {
            // Retry after a short delay if sidebar not found (max 20 retries = 2 seconds)
            if (retryCount < 20) {
                setTimeout(() => setupCollapsedSubmenuHover(retryCount + 1), 100);
            }
            return;
        }
        
        // Check if menu items are rendered
        const menuItems = sidebar.querySelectorAll('.nav-item');
        if ((!menuItems || menuItems.length === 0) && retryCount < 20) {
            // Retry after a short delay if menu not rendered yet
            setTimeout(() => setupCollapsedSubmenuHover(retryCount + 1), 100);
            return;
        }
        
        const isCollapsed = sidebar.classList.contains('collapsed');
        
        const handleNavItemHover = (navItem) => {
            const collapse = navItem.querySelector('.collapse');
            if (!collapse) return;
            
            // Skip nếu đã setup và trạng thái không đổi
            if (navItem.dataset.hoverSetup === 'true' && navItem.dataset.lastState === (isCollapsed ? 'collapsed' : 'expanded')) {
                return;
            }
            navItem.dataset.hoverSetup = 'true';
            navItem.dataset.lastState = isCollapsed ? 'collapsed' : 'expanded';
            
            const navLink = navItem.querySelector('.nav-link[data-bs-toggle="collapse"]');
            if (!navLink) return;
            
            // Remove click handler cũ nếu có
            if (navLink._collapseClickHandler) {
                navLink.removeEventListener('click', navLink._collapseClickHandler, true);
                delete navLink._collapseClickHandler;
            }
            
            // Chỉ add click handler khi sidebar collapsed
            if (isCollapsed) {
                disableNavLinkCollapse(navLink);
                const clickHandler = function(e) {
                    if (sidebar.classList.contains('collapsed')) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        return false;
                    }
                };
                
                navLink.addEventListener('click', clickHandler, true);
                navLink._collapseClickHandler = clickHandler;
                
                // Đảm bảo collapse không có class show
                if (collapse) {
                    collapse.classList.remove('show');
                }
            } else {
                enableNavLinkCollapse(navLink);
            }

            let hideTimeout = null;
            
            const showSubmenu = () => {
                if (sidebar.classList.contains('collapsed')) {
                    if (hideTimeout) {
                        clearTimeout(hideTimeout);
                        hideTimeout = null;
                    }
                    // Thêm class để CSS có thể áp dụng
                    navItem.classList.add('submenu-hover');
                }
            };
            
            const hideSubmenu = () => {
                if (sidebar.classList.contains('collapsed')) {
                    hideTimeout = setTimeout(() => {
                        // Kiểm tra lại xem có đang hover không
                        if (!navItem.matches(':hover') && !collapse.matches(':hover')) {
                            navItem.classList.remove('submenu-hover');
                        }
                    }, 150);
                }
            };
            
            // Sử dụng cả mouseenter/mouseleave và mouseover/mouseout
            navItem.addEventListener('mouseenter', showSubmenu, false);
            navItem.addEventListener('mouseleave', hideSubmenu, false);
            navItem.addEventListener('mouseover', showSubmenu, false);
            
            collapse.addEventListener('mouseenter', showSubmenu, false);
            collapse.addEventListener('mouseleave', hideSubmenu, false);
            collapse.addEventListener('mouseover', showSubmenu, false);
        };
        
        // Setup cho tất cả nav-items có collapse
        const navItems = sidebar.querySelectorAll('.nav-item');
        navItems.forEach(item => {
            const collapse = item.querySelector('.collapse');
            if (collapse) {
                handleNavItemHover(item);
            }
        });
        
        // Observer để handle dynamic content
        if (!sidebar.dataset.observerSetup) {
            sidebar.dataset.observerSetup = 'true';
            const observer = new MutationObserver(() => {
                const navItems = sidebar.querySelectorAll('.nav-item');
                navItems.forEach(item => {
                    const collapse = item.querySelector('.collapse');
                    if (collapse) {
                        handleNavItemHover(item);
                    }
                });
            });
            
            observer.observe(sidebar, { childList: true, subtree: true });
        }
    }
    
    // Setup khi DOM ready và sau khi Blazor render
    function initSubmenuHover() {
        setTimeout(() => {
            setupCollapsedSubmenuHover();
        }, 100);
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSubmenuHover);
    } else {
        initSubmenuHover();
    }
    
    // Setup lại khi sidebar toggle
    const originalToggleSidebar = window.toggleSidebar;
    if (typeof originalToggleSidebar === 'function') {
        window.toggleSidebar = function() {
            originalToggleSidebar();
            // Đợi sidebar toggle xong rồi mới setup lại
            setTimeout(() => {
                const sidebar = document.getElementById('sidebar');
                if (!sidebar) return;
                
                // Reset hover setup để setup lại với trạng thái mới
                const navItems = sidebar.querySelectorAll('.nav-item');
                navItems.forEach(item => {
                    delete item.dataset.hoverSetup;
                    delete item.dataset.lastState;
                    // Remove click handler nếu có
                    const navLink = item.querySelector('.nav-link[data-bs-toggle="collapse"], .nav-link[data-bs-toggle-disabled="true"]');
                    if (navLink && navLink._collapseClickHandler) {
                        const handler = navLink._collapseClickHandler;
                        navLink.removeEventListener('click', handler, true);
                        delete navLink._collapseClickHandler;
                    }
                    if (navLink) {
                        enableNavLinkCollapse(navLink);
                    }
                });
                
                // Setup lại hover handlers với trạng thái mới
                setupCollapsedSubmenuHover();
                
                // Clear và reapply active parent menu styles
                applyActiveParentMenuStyles();
                
                // Expand active menu sau khi toggle sidebar
                window.expandActiveMenu?.();
            }, 100);
        };
    }
    
    // Setup lại sau khi restore sidebar state và khi Blazor render xong
    setTimeout(setupCollapsedSubmenuHover, 600);
    setTimeout(setupCollapsedSubmenuHover, 1000);
    setTimeout(setupCollapsedSubmenuHover, 2000);
    
    // Lắng nghe khi Blazor đã load xong
    window.addEventListener('load', () => {
        setTimeout(setupCollapsedSubmenuHover, 500);
    });
    
    // blazor.web.js owns application startup; only schedule sidebar setup here.
    if (window.Blazor) {
        setTimeout(setupCollapsedSubmenuHover, 500);
    }
    
    // Override CSS cho menu cha khi active bằng JavaScript
    // Override CSS cho menu cha khi active bằng JavaScript
function applyActiveParentMenuStyles(retryCount = 0) {
    const sidebar = document.getElementById('sidebar');
    if (!sidebar) {
        // Retry after a short delay if sidebar not found (max 20 retries = 2 seconds)
        if (retryCount < 20) {
            setTimeout(() => applyActiveParentMenuStyles(retryCount + 1), 100);
        }
        return;
    }
    
    // Check if menu items are rendered
    const menuItems = sidebar.querySelectorAll('.nav-item');
    if ((!menuItems || menuItems.length === 0) && retryCount < 20) {
        // Retry after a short delay if menu not rendered yet
        setTimeout(() => applyActiveParentMenuStyles(retryCount + 1), 100);
        return;
    }
    
    const isCollapsed = sidebar.classList.contains('collapsed');
    
    // Không can thiệp vào styles - để CSS tự nhiên xử lý tất cả
    // CSS classes sẽ xử lý active states, collapsed states, etc.
}
    // Áp dụng styles khi DOM ready
    function initActiveParentMenuStyles() {
        applyActiveParentMenuStyles();
        window.expandActiveMenu?.();
        
        const sidebar = document.getElementById('sidebar');
        if (sidebar) {
            // Observe khi có thêm menu items mới (Blazor render)
            if (!sidebar.dataset.menuObserverSetup) {
                sidebar.dataset.menuObserverSetup = 'true';
                const menuObserver = new MutationObserver(function() {
                    setTimeout(() => {
                        applyActiveParentMenuStyles();
                        window.expandActiveMenu?.();
                    }, 200);
                });
                menuObserver.observe(sidebar, { childList: true, subtree: true });
            }
        }
    }
    
    // Chạy khi DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
            initActiveParentMenuStyles();
        });
    } else {
        initActiveParentMenuStyles();
    }
    
    // Chạy lại sau khi Blazor render (chỉ một lần)
    setTimeout(() => {
        initActiveParentMenuStyles();
    }, 800);
</script>
