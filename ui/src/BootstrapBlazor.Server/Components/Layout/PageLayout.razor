                                            {
                                                <li class="nav-item">
                                                    <NavLink class="nav-link d-flex align-items-center justify-content-between py-2" href="javascript:void(0);" data-bs-toggle="collapse" data-bs-target="#toolsETL" aria-expanded="false" aria-controls="toolsETL">
                                                        <span class="d-flex align-items-center">
                                                            <i class="fa-solid fa-gears"></i>
                                                            <span>@menu.Text</span>
                                                        </span>
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                                            <path d="M10 19a1 1 0 0 1-.64-.23a1 1 0 0 1-.13-1.41L13.71 12L9.39 6.63a1 1 0 0 1 .15-1.41a1 1 0 0 1 1.46.15l4.83 6a1 1 0 0 1 0 1.27l-5 6A1 1 0 0 1 10 19"/>
                                                        </svg>
                                                    </NavLink>
                                                    <div class="collapse" id="toolsETL">
                                                        <ul class="nav flex-column">
                                                            @foreach (var child in menu.Items)
                                                            {
                                                                <li class="nav-item">
                                                                    <NavLink class="nav-link d-flex align-items-center py-2 ps-4" href="@child.Url" Match="NavLinkMatch.All">
                                                                        <i class="@child.Icon me-2" style="font-size: 0.9rem;"></i>
                                                                        <span>@child.Text</span>
                                                                    </NavLink>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </li>
                                            }
                                            else if (menu.Text == "Dashboard" && menu.Items != null && menu.Items.Any())
                                            {
                                                <li class="nav-item">
                                                    <NavLink class="nav-link d-flex align-items-center justify-content-between py-2" href="javascript:void(0);" data-bs-toggle="collapse" data-bs-target="#toolsDashboard" aria-expanded="false" aria-controls="toolsDashboard">
                                                        <span class="d-flex align-items-center">
                                                            <i class="fa-solid fa-gauge-high"></i>
                                                            <span>@menu.Text</span>
                                                        </span>
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
