                                                    <NavLink class="nav-link d-flex align-items-center justify-content-between py-2" href="javascript:void(0);" data-bs-toggle="collapse" data-bs-target="#toolsSystem" aria-expanded="false" aria-controls="toolsSystem">
                                                        <span class="d-flex align-items-center">
