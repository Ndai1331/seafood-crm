@inherits LayoutComponentBase
@inject IOptionsMonitor<WebsiteOptions> WebsiteOption


<BootstrapBlazorRoot>
    <CascadingValue Value="this" IsFixed="true">
        @if (!string.IsNullOrEmpty(ImpersonatedUserName))
        {
            <div class="impersonation-banner d-flex align-items-center justify-content-center gap-3"
                 style="position:fixed;top:0;left:0;right:0;z-index:2000;background:#b45309;color:#fff;padding:6px 12px;font-weight:600;">
                <span><i class="fa-solid fa-user-secret me-2"></i>Đang đăng nhập hộ với tư cách <strong>@ImpersonatedUserName</strong>.</span>
                <button class="btn btn-sm btn-light" @onclick="ExitImpersonationAsync">
                    <i class="fa-solid fa-right-from-bracket me-1"></i>Thoát
                </button>
            </div>
        }
        <!-- Main Layout Container -->
        <div class="container-fluid vh-100 p-0">
            <div class="row h-100 g-0">
                <!-- Left Sidebar Column - Desktop Only -->
                <div id="sidebar" class="d-none d-lg-block">
                    <!-- Fixed Header Area -->
                    <div class="sidebar-header">
                        <NavLink class="text-decoration-none" href="/">
                            <div class="logo-container">
                                <span class="brand-name">SEAFOOD CRM</span>
                            </div>
                        </NavLink>
                    </div>
                    
                    <!-- Scrollable Content Area -->
                    <div class="sidebar-scrollable">
                        <div class="sidebar-content h-100">
                        <nav class="sidebar-nav">
                            <div class="nav-section">
                                <ul class="nav flex-column">
                                    @if (Menus != null && Menus.Any())
                                    {
                                        // Add BÁO CÁO section header
                                        var hasReports = Menus.Any(m => m.Text == "Tools SEO" || m.Text == "Chi phí SEO");
                                        if (hasReports)
                                        {
                                            <li class="nav-section-header">
                                                <span class="section-header-text">QUẢN LÝ</span>
                                            </li>
                                        }
                                        
                                        foreach (var menu in Menus)
                                        {
                                            if (menu.Text == "Tools SEO" && menu.Items != null && menu.Items.Any())
                                            {
                                                <li class="nav-item">
                                                    <NavLink class="nav-link d-flex align-items-center justify-content-between py-2" href="javascript:void(0);" data-bs-toggle="collapse" data-bs-target="#toolsSEO" aria-expanded="false" aria-controls="toolsSEO">
                                                        <span class="d-flex align-items-center">
                                                            <i class="fa-solid fa-chart-pie"></i>
                                                            <span>@menu.Text</span>
                                                        </span>
                                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                                            <path d="M10 19a1 1 0 0 1-.64-.23a1 1 0 0 1-.13-1.41L13.71 12L9.39 6.63a1 1 0 0 1 .15-1.41a1 1 0 0 1 1.46.15l4.83 6a1 1 0 0 1 0 1.27l-5 6A1 1 0 0 1 10 19"/>
                                                        </svg>
                                                    </NavLink>
                                                    <div class="collapse" id="toolsSEO">
                                                        <ul class="nav flex-column">
                                                            @foreach (var child in menu.Items)
                                                            {
                                                                <li class="nav-item">
                                                                    <NavLink class="nav-link d-flex align-items-center py-2 ps-4" href="@child.Url" Match="NavLinkMatch.All">
                                                                        <i class="@child.Icon me-2" style="font-size: 0.9rem;"></i>
                                                                        <span>@child.Text</span>
                                                                    </NavLink>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </li>
                                            }
                                            else if (menu.Text == "Chi phí SEO" && menu.Items != null && menu.Items.Any())
