{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RemoteServices": {
    "BaseUrl": "http://localhost:5093/api/"
  },
  "WebsiteOptions": {
    "ServerUrl": "http://localhost:5053"
  },
  "BootstrapBlazorOptions": {
    "ToastDelay": 4000,
    "MessageDelay": 4000,
    "SwalDelay": 4000,
    "EnableErrorLogger": false,
    "DefaultCultureInfo": "vi-VN",
    "FallbackCulture": "vi",
    "SupportedCultures": [
      "vi-VN",
      "en-US"
    ],
    "TableSettings": {
      "CheckboxColumnWidth": 36
    },
    "IgnoreLocalizerMissing": true
  }
}
